---
import Layout from "../components/Layout.astro";

const sports = [
  { name: "Football", icon: "⚽", href: "/sports/football" },
  { name: "Basketball", icon: "🏀", href: "/sports/basketball" },
  { name: "NFL", icon: "🏈", href: "/sports/nfl" },
  { name: "Soccer", icon: "⚽", href: "/sports/soccer" },
  { name: "Hockey", icon: "🏒", href: "/sports/hockey" },
  { name: "Tennis", icon: "🎾", href: "/sports/tennis" },
  { name: "Baseball", icon: "⚾", href: "/sports/baseball" },
  { name: "F1", icon: "🏎️", href: "/sports/f1" },
  { name: "Boxing", icon: "🥊", href: "/sports/boxing" },
];

const keyFeatures = [
  {
    title: "Expert Analysis",
    description: "Deep statistical analysis and expert insights on every match",
    icon: "📊"
  },
  {
    title: "Real-Time Updates",
    description: "Get instant notifications on odds changes and match updates",
    icon: "⚡"
  },
  {
    title: "Proven Track Record",
    description: "Transparent win rate statistics across all sports",
    icon: "🎯"
  },
  {
    title: "AI-Powered Predictions",
    description: "Advanced machine learning algorithms analyzing thousands of data points",
    icon: "🤖"
  }
];
---

<Layout title="Match Predictz - Expert Sports Predictions & Betting Tips">
  <div class="space-y-16">
    <section class="text-center py-12">
      <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-green-400 to-blue-500 bg-clip-text text-transparent">
        Match Predictz
      </h1>
      <p class="text-xl text-neutral-300 mb-6">
        Expert Sports Predictions & Betting Analysis
      </p>
      <p class="text-lg text-neutral-400 max-w-2xl mx-auto">
        Your ultimate destination for data-driven sports predictions. We analyze thousands of matches across multiple sports to deliver accurate predictions and betting insights.
      </p>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-8 text-center">Key Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {keyFeatures.map((feature) => (
          <div class="bg-neutral-700 p-6 rounded-lg border border-neutral-600 hover:border-green-500 transition-all">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
            <p class="text-neutral-300">{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-8 text-center">Browse Sports</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {sports.map((sport) => (
          <a
            href={sport.href}
            class="bg-neutral-700 p-6 rounded-lg border border-neutral-600 hover:border-green-500 hover:scale-105 transition-all text-center group"
          >
            <div class="text-5xl mb-3">{sport.icon}</div>
            <h3 class="text-lg font-semibold group-hover:text-green-400 transition-colors">
              {sport.name}
            </h3>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-neutral-700 p-8 rounded-lg border border-neutral-600">
      <h2 class="text-3xl font-bold mb-4 text-center">Why Choose Match Predictz?</h2>
      <div class="space-y-4 text-neutral-300">
        <p class="text-lg">
          Match Predictz combines cutting-edge data analytics with expert sports knowledge to provide you with the most accurate predictions in the industry. Our team of analysts work around the clock to ensure you have the latest insights for your betting decisions.
        </p>
        <p class="text-lg">
          Whether you're a seasoned bettor or just starting out, our platform provides comprehensive statistics, head-to-head records, form analysis, and expert tips to help you make informed decisions.
        </p>
      </div>
    </section>

    <section class="text-center py-8">
      <h2 class="text-2xl font-bold mb-4">Ready to Start Winning?</h2>
      <p class="text-neutral-300 mb-6">
        Join thousands of successful bettors who trust Match Predictz for their sports predictions
      </p>
      <a
        href="/sports/football"
        class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-lg transition-colors"
      >
        View Today's Predictions
      </a>
    </section>
  </div>
</Layout>
